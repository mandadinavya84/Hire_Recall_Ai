# HireRecall AI Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication Secrets
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Database Configuration (Optional: defaults to built-in JSON persistence if not provided)
# MONGODB_URI=mongodb://localhost:27017/hirerecall

# Hindsight Memory Integration (Official @vectorize-io/hindsight-client)
HINDSIGHT_MODE=remote
# Base URL: 'https://api.hindsight.vectorize.io' for Hindsight Cloud, or 'http://localhost:8888' for local Hindsight
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# API Key: Required when connecting to Hindsight Cloud (leave blank for local Hindsight without auth)
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=hirerecall_recruitment

# AI Intelligence Provider Configuration (Gemini / OpenAI / Heuristic fallback)
AI_PROVIDER=embedded # 'embedded' | 'gemini' | 'openai'
GEMINI_API_KEY=
OPENAI_API_KEY=

# Recruiter Persona Preferences Defaults
DEFAULT_RECRUITER_NAME=Priya Sharma
DEFAULT_RECRUITER_ROLE="Senior Tech Recruiter & Bar Raiser"
DEFAULT_RECRUITER_FOCUS="Practical coding, System Design, Communication"
DEFAULT_RECRUITER_STYLE="Scenario-based, Real-world architecture problems"
